# ══════════════════════════════════════════════════════════════════════════════
# SORTING STATION — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Modbus TCP (Factory I/O) ──────────────────────────────────────────────────
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502
MODBUS_TIMEOUT=2.0
MODBUS_UNIT_ID=1
MODBUS_MAX_RETRIES=3

# ── ThingsBoard Server ────────────────────────────────────────────────────────
TB_HOST=tb-dev.imespro.ai
TB_HTTP_PORT=58090
TB_MQTT_PORT=1883
TB_DEVICE_NAME=sorting-station-01
TB_STATION_ID=SS-01
TB_DEVICE_TOKEN=
TB_USE_PROVISIONING=false
TB_PROVISION_KEY=
TB_PROVISION_SECRET=

# ── MQTT / ThingsBoard ────────────────────────────────────────────────────────
# Run: python tools/probe_mqtt_port.py  to find the correct port for tb-dev.imespro.ai
# Then set the port found below:
MQTT_PORT=1883
MQTT_HOST=tb-dev.imespro.ai
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ACCESS_TOKEN=
MQTT_TLS_CA_CERTS=
MQTT_CLEAN_SESSION=true

# ── Timing (milliseconds) ─────────────────────────────────────────────────────
SCAN_INTERVAL_MS=50
SORTER_TICK_MS=35
SUPERVISION_MS=100
TELEMETRY_MS=150
EMITTER_PULSE_MS=200
BLADE_STABILIZE_MS=500
CONVEYOR_RAMP_MS=100

# ── Watchdog Timeouts (milliseconds) ─────────────────────────────────────────
WATCHDOG_SCAN_TIMEOUT_MS=1000
WATCHDOG_TELEMETRY_TIMEOUT_MS=5000

# ── Operation Timeouts (seconds) ──────────────────────────────────────────────
VISION_READ_TIMEOUT=3.0
SORT_TIMEOUT=5.0
JAM_DETECTION_TIMEOUT=12.0
BLADE_TIMEOUT=2.0
CONVEYOR_TIMEOUT=10.0

# ── Conveyor Error Detection (milliseconds) ───────────────────────────────────
CONVEYOR_JAM_TIMEOUT_MS=5000
CONVEYOR_VISION_STALL_TIMEOUT_MS=3000
CONVEYOR_SUDDEN_STOP_DEBOUNCE_MS=500

# ── Reconnect Strategy ────────────────────────────────────────────────────────
MODBUS_RECONNECT_BASE_S=1.0
MODBUS_RECONNECT_MAX_S=30.0
MQTT_RECONNECT_BASE_S=2.0
MQTT_RECONNECT_MAX_S=60.0
MQTT_OFFLINE_BUFFER_SIZE=500

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Serial Bridge (ESP32 Gateway) ─────────────────────────────────────────────
# Leave SERIAL_PORT empty to disable SerialBridge.
SERIAL_PORT=
SERIAL_BAUD=115200
