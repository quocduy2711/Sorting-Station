# ══════════════════════════════════════════════════════════════════════════════
# SORTING STATION — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Modbus TCP (Factory I/O) ──────────────────────────────────────────────────
# Factory I/O chay Modbus TCP/IP Server tren 192.168.2.180:502
# Khong dung 127.0.0.1 vi Factory IO bind vao NIC cu the, khong phai loopback
MODBUS_HOST=192.168.2.49
MODBUS_PORT=502
MODBUS_TIMEOUT=2.0
MODBUS_UNIT_ID=1
MODBUS_MAX_RETRIES=3

# ── ThingsBoard Server ────────────────────────────────────────────────────────
# CẢNH BÁO: tb-dev.imespro.ai chỉ mở port 58080 (UI) và 58090 (API)
# Port MQTT 1883/8883 CHƯA được expose → cần admin server mở port MQTT
# hoặc dùng ThingsBoard local (xem hướng dẫn dưới)
TB_HOST=tb-dev.imespro.ai
TB_HTTP_PORT=58090
TB_MQTT_PORT=1883
TB_DEVICE_NAME=conveyor-belt
TB_STATION_ID=SS-01
TB_DEVICE_TOKEN=rVTJ9neuy3CosQz4javt
TB_USE_PROVISIONING=false
TB_PROVISION_KEY=
TB_PROVISION_SECRET=

# ── MQTT / ThingsBoard (Legacy Mapping) ───────────────────────────────────────
MQTT_HOST=tb-dev.imespro.ai
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ACCESS_TOKEN=rVTJ9neuy3CosQz4javt
MQTT_TLS_CA_CERTS=
MQTT_CLEAN_SESSION=true

# ── Timing (milliseconds) ─────────────────────────────────────────────────────
SCAN_INTERVAL_MS=50
SORTER_TICK_MS=35
SUPERVISION_MS=100
TELEMETRY_MS=150
EMITTER_PULSE_MS=200
BLADE_STABILIZE_MS=500
CONVEYOR_RAMP_MS=100

# ── Watchdog Timeouts (milliseconds) ─────────────────────────────────────────
WATCHDOG_SCAN_TIMEOUT_MS=1000
WATCHDOG_TELEMETRY_TIMEOUT_MS=5000

# ── Operation Timeouts (seconds) ──────────────────────────────────────────────
VISION_READ_TIMEOUT=3.0
SORT_TIMEOUT=5.0
JAM_DETECTION_TIMEOUT=12.0
BLADE_TIMEOUT=2.0
CONVEYOR_TIMEOUT=10.0

# ── Reconnect Strategy ────────────────────────────────────────────────────────
MODBUS_RECONNECT_BASE_S=1.0
MODBUS_RECONNECT_MAX_S=30.0
MQTT_RECONNECT_BASE_S=2.0
MQTT_RECONNECT_MAX_S=60.0
MQTT_OFFLINE_BUFFER_SIZE=500

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
